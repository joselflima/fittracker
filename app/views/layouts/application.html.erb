<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · FitTracker" : "FitTracker" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#101211">
    <meta name="turbo-cache-control" content="no-cache">
    <%= csrf_meta_tags %><%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="manifest" href="<%= pwa_manifest_path %>">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <meta name="apple-mobile-web-app-title" content="FitTracker">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="<%= current_user ? 'signed-in' : 'guest' %>">
    <header class="mast"><div class="bar">
      <%= link_to current_user ? root_path : new_session_path, class: "brand", aria: { label: "FitTracker" } do %>
        <span class="brand-mark"><%= icon(:pulse) %></span><span>Fit<span class="light">Tracker</span></span>
      <% end %>
      <% if current_user %>
        <nav aria-label="Navegação principal">
          <% [[root_path, :today, "Hoje"], [workouts_path, :workouts, "Treinos"], [dashboard_path, :dashboard, "Evolução"], [lab_results_path, :labs, "Exames"], [profile_path, :profile, "Perfil"]].each do |path, glyph, label| %>
            <% selected = current_page?(path) || (glyph == :workouts && controller_name == "workouts") || (glyph == :dashboard && controller_name == "dashboard") || (glyph == :profile && controller_name == "profiles") %>
            <%= link_to path, aria: { current: selected ? "page" : nil } do %><%= icon(glyph) %><span><%= label %></span><% end %>
          <% end %>
        </nav>
        <%= button_to session_path, method: :delete, class: "quiet exit" do %><%= icon(:exit) %> Sair<% end %>
      <% end %>
    </div></header>
    <main>
      <% flash.each do |kind, message| %><p role="<%= kind == 'alert' ? 'alert' : 'status' %>" class="flash <%= kind %>"><%= message %></p><% end %>
      <%= yield %>
    </main>
  </body>
</html>
